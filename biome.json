{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/.umi/**",
      "!**/.umi-production/**",
      "!**/.umi-test/**",
      "!**/.umi-test-production/**",
      "!**/mock/**",
      "!**/dist/**",
      "!**/server/**",
      "!**/public/**",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "jsxRuntime": "reactClassic",
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/services/**/*.ts"
      ],
      "linter": {
        "rules": {
          "recommended": false,
          "suspicious": {
            "noExplicitAny": "error"
          },
          "correctness": {
            "noUnusedImports": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/services/ant-design-pro/api.ts",
        "**/src/services/ant-design-pro/login.ts",
        "**/src/services/ant-design-pro/typings.d.ts",
        "**/src/services/files.ts",
        "**/src/services/mlflow.ts",
        "**/src/services/pointcloud.ts",
        "**/src/services/system/config.ts",
        "**/src/services/system/user.ts",
        "**/src/services/trainingCode/adminWorkspace.ts",
        "**/src/services/trainingCode/assets.ts",
        "**/src/services/trainingCode/display.ts",
        "**/src/services/trainingCode/inventory.ts",
        "**/src/services/trainingCode/preview.ts",
        "**/src/services/trainingCode/v2Content.ts",
        "**/src/services/trainingCode/workspace.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/services/dataset.ts",
        "**/src/services/dataset/**/*.ts",
        "**/src/services/task.ts",
        "**/src/services/taskTypes.ts",
        "**/src/services/trainingCode/approval.ts",
        "**/src/services/model.ts",
        "**/src/services/datasetUploadResponse.ts",
        "**/src/services/modelReadResponse.ts",
        "**/src/pages/task/detail/useExperimentVersions.ts"
      ],
      "linter": {
        "rules": {
          "recommended": true,
          "suspicious": {
            "noExplicitAny": "error"
          },
          "correctness": {
            "useExhaustiveDependencies": "error"
          }
        }
      }
    }
  ]
}
