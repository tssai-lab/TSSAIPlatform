# 与 GPU 训练使用同一 CUDA/PyTorch 基线；构建时必须传入已锁定的 digest。
ARG INFERENCE_GPU_BASE_IMAGE
FROM ${INFERENCE_GPU_BASE_IMAGE}

USER root
WORKDIR /app

ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

COPY requirements.txt .
COPY requirements-ml-cpu.txt .
RUN python -m pip uninstall -y opencv-python opencv-contrib-python opencv-contrib-python-headless || true \
    && python -m pip install --no-cache-dir -r requirements.txt -i "${PYPI_INDEX_URL}" \
    && python -m pip install --no-cache-dir -r requirements-ml-cpu.txt -i "${PYPI_INDEX_URL}" \
    && python -m pip uninstall -y opencv-python opencv-contrib-python opencv-contrib-python-headless \
    && python -m pip install --no-cache-dir --force-reinstall --no-deps \
       opencv-python-headless==4.11.0.86 -i "${PYPI_INDEX_URL}"

COPY infer_worker.py .

USER 10001
RUN HOME=/tmp/tss-runtime-home PYTHONNOUSERSITE=1 python -c \
    "import cv2, numpy, torch, transformers, ultralytics; assert torch.version.cuda" \
    && test -x /usr/bin/timeout

ENTRYPOINT ["python", "/app/infer_worker.py"]
