{
  "name": "tss-ai-platform-frontend",
  "version": "6.0.0",
  "private": true,
  "description": "TSS AI 平台前端：资产、训练、推理与系统管理",
  "repository": "https://github.com/tssai-lab/TSSAIPlatform.git",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "biome:lint": "npx @biomejs/biome lint",
    "prebuild": "node scripts/copy-swagger-ui.cjs",
    "build": "max build",
    "dev": "npm run start:dev",
    "dev:local": "cross-env HOST=127.0.0.1 PORT=8001 REACT_APP_ENV=dev MOCK=none UMI_ENV=dev DEV_API_TARGET=http://127.0.0.1:8080 DEV_MLFLOW_TARGET=http://127.0.0.1:5000 max dev",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "lint": "npm run biome:lint && npm run lint:governance && npm run tsc",
    "lint-staged": "lint-staged",
    "openapi": "max openapi",
    "prepare": "husky",
    "preview": "npm run build && max preview --port 8000",
    "preview:server": "npm run build && cross-env HOST=0.0.0.0 PORT=8000 max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "serve:prod": "npm run build && cross-env HOST=0.0.0.0 PORT=8000 node scripts/serve-dist.cjs",
    "start": "cross-env HOST=0.0.0.0 PORT=3000 UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "tsc": "tsc --noEmit",
    "lint:governance": "node scripts/qa/check-service-type-baseline.mjs && biome lint --error-on-warnings src/services/dataset.ts src/services/dataset src/services/task.ts src/services/taskTypes.ts src/services/trainingCode/approval.ts src/services/model.ts src/services/datasetUploadResponse.ts src/services/modelReadResponse.ts src/pages/task/detail/useExperimentVersions.ts"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^2.7.19",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.25.4",
    "antd-style": "^3.7.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.3.0",
    "@biomejs/biome": "^2.0.6",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.10",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/react-helmet": "^6.1.11",
    "@umijs/max": "4.6.61",
    "cross-env": "^7.0.3",
    "express": "^4.21.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "swagger-ui-dist": "^5.17.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
