# C3 reviewed storage identity for the internal control-plane host.
# This file contains no credential. Never replace the by-id path with /dev/sda.
TSS_STORAGE_DEVICE_BY_ID=/dev/disk/by-id/ata-ST8000NM017B-2TJ103_WWZ8BPXP
TSS_STORAGE_EXPECTED_MODEL=ST8000NM017B-2TJ103
TSS_STORAGE_EXPECTED_SERIAL=WWZ8BPXP
TSS_STORAGE_EXPECTED_WWN=0x5000c500fa8eabce
TSS_STORAGE_EXPECTED_BYTES=8001563222016
# The disk reports 8090 power-on hours. On 2026-08-16 the user explicitly
# accepted skipping the running extended test for this validation environment.
# This weaker policy still requires overall SMART health, a completed short
# test, zero critical media/link counters and no self-test currently running.
TSS_STORAGE_SMART_POLICY=short-plus-critical-attributes
TSS_STORAGE_PARTITION_GIB=2048
TSS_STORAGE_FS_LABEL=tss-AIplatform
TSS_STORAGE_MOUNT_POINT=/srv/tss-AIplatform
