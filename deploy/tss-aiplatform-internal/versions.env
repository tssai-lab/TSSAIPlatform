TSS_KUBEADM_API_VERSION=v1beta4
TSS_KUBELET_CONFIG_API_VERSION=v1beta1
TSS_CONTAINERD_PAUSE_IMAGE=registry.k8s.io/pause:3.10.1
TSS_CALICO_VERSION=v3.32.1
TSS_METRICS_SERVER_VERSION=v0.9.0
TSS_NVIDIA_DEVICE_PLUGIN_VERSION=v0.17.1
TSS_DCGM_EXPORTER_VERSION=4.5.3-4.8.2-distroless
