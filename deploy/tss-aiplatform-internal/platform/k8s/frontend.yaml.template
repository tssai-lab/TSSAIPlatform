apiVersion: v1
kind: Namespace
metadata:
  name: tss-platform-system
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tss-aiplatform-frontend
  namespace: tss-platform-system
  labels:
    app.kubernetes.io/name: tss-aiplatform-frontend
    app.kubernetes.io/part-of: tss-aiplatform-internal
  annotations:
    tss.ai/frontend-source-sha: REPLACE_FRONTEND_SOURCE_SHA
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: tss-aiplatform-frontend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tss-aiplatform-frontend
        app.kubernetes.io/part-of: tss-aiplatform-internal
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/hostname: REPLACE_CONTROL_PLANE_NODE
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      containers:
        - name: frontend
          image: REPLACE_FRONTEND_IMAGE
          imagePullPolicy: Never
          env:
            - name: BACKEND_UPSTREAM
              value: http://REPLACE_CONTROL_PLANE_IP:REPLACE_BACKEND_PORT
            - name: MLFLOW_UPSTREAM
              value: http://REPLACE_CONTROL_PLANE_IP:REPLACE_MLFLOW_PORT
          ports:
            - name: http
              containerPort: 80
              hostPort: REPLACE_FRONTEND_PORT
              hostIP: REPLACE_CONTROL_PLANE_IP
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
            timeoutSeconds: 3
            failureThreshold: 4
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 250m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - CHOWN
                - NET_BIND_SERVICE
                - SETGID
                - SETUID
            seccompProfile:
              type: RuntimeDefault
