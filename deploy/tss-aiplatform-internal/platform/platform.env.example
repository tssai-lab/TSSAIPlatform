# Copy outside Git, replace every REPLACE_* value, and keep the file root-owned.
# This file contains no password or token.
TSS_PLATFORM_ENVIRONMENT=tss-aiplatform-internal
TSS_PLATFORM_ROOT=/srv/tss-AIplatform/platform
TSS_REPOSITORY_ROOT=/srv/tss-AIplatform/repository
TSS_PLATFORM_HOSTNAME=REPLACE_CONTROL_PLANE_HOSTNAME
TSS_PLATFORM_BIND_IP=REPLACE_CONTROL_PLANE_IP
TSS_PLATFORM_WORKER_IP=REPLACE_WORKER_IP
TSS_PLATFORM_WORKER_NODE=tss-ai-worker-01
# Keep false for CPU-only clusters. Set true only after every reviewed GPU node
# uses the isolated NVIDIA runtime and the locked monitoring images are imported.
TSS_ENABLE_GPU_WORKER=false

# C5 uses dedicated high ports. Re-run the live port gate before applying.
TSS_BACKEND_PORT=18080
TSS_POSTGRES_PORT=15432
TSS_REDIS_PORT=16379
TSS_MINIO_API_PORT=19010
TSS_MINIO_CONSOLE_PORT=19011
TSS_MLFLOW_PORT=15000
TSS_CORS_ALLOWED_ORIGIN_PATTERNS=http://REPLACE_CONTROL_PLANE_IP:*

TSS_KUBECTL_PATH=/usr/bin/kubectl
TSS_ADMIN_KUBECONFIG=/etc/kubernetes/admin.conf
TSS_MIN_ROOT_FREE_GIB=10
TSS_MIN_PLATFORM_FREE_GIB=100

# 精确选卡默认关闭。只有 DRA 探针和三镜像 GPU 运行时包验收通过后，
# 才能同时改为 kubectl/true，并把推理镜像替换为锁文件里的 digest 引用。
TSS_K8S_CLIENT_MODE=fabric8
TSS_EXACT_GPU_SELECTION_ENABLED=false
TSS_GPU_DEVICE_CLASS_NAME=gpu.nvidia.com
TSS_GPU_INFERENCE_WORKER_IMAGE=tss-inference-worker-gpu:local

# All images are project-specific aliases. Their source manifest digests and
# exact linux/amd64 source image IDs and runtime-content fingerprints are locked
# in platform-images.lock and checked before Compose may start.
TSS_POSTGRES_IMAGE=tss-aiplatform-internal/postgres:16.13-f7ebf09eb01b
TSS_MINIO_IMAGE=tss-aiplatform-internal/minio:release-20220104-e31e0721a96b
TSS_REDIS_IMAGE=tss-aiplatform-internal/redis:7.4.11-alpine-5509c0097c60
TSS_MLFLOW_IMAGE=tss-aiplatform-internal/mlflow-lite:2e96544b-ced0a4d72541
TSS_BACKEND_IMAGE=tss-aiplatform-internal/backend:110108b7-91582905b5ed
