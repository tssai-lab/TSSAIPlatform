# Non-secret configuration for the current Main integration node.
# Install a reviewed copy as /etc/tss-platform/node.env with mode 600.

TSS_NODE_ID=main
TSS_NODE_ROLES=app,worker
TSS_ENVIRONMENT=poc
TSS_PLATFORM_DIR=/opt/tss-platform
TSS_DEPLOY_USER=tss-deployer

TSS_CLUSTER_NAME=tss-training
TSS_BACKEND_HOST_PORT=18080
TSS_MINIO_HOST_PORT=9010
TSS_MLFLOW_HOST_PORT=15000
TSS_BACKEND_LISTEN_PORT=8080
TSS_MLFLOW_LISTEN_PORT=5000

TSS_SERVER_ADDRESS=127.0.0.1
TSS_SPRING_PROFILES_ACTIVE=default
TSS_POSTGRES_CONTAINER=tss-postgres
TSS_MINIO_CONTAINER=tss-minio
TSS_DATASOURCE_HOST=127.0.0.1
TSS_DATASOURCE_PORT=5432
TSS_MINIO_ENDPOINT=http://127.0.0.1:9010
TSS_MINIO_BUCKET=models
TSS_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
TSS_TRAINING_EXPERIMENT_NAME=tss-training
TSS_K8S_BACKEND_SERVICE_URL=http://tss-backend:8080
TSS_K8S_MINIO_SERVICE_URL=http://tss-minio:9000
TSS_K8S_MLFLOW_SERVICE_URL=http://tss-mlflow:5000

# Main uses kubeadm: the physical directory is mounted directly as hostPath.
# Keep the backend switch false until the node preparation and real worker
# probe have passed and tss.ai/model-cache-ready=true has been added.
TSS_MODEL_CACHE_ENABLED=false
TSS_MODEL_CACHE_HOST_PATH=/opt/tss-platform/model-cache
TSS_MODEL_CACHE_NODE_PATH=/opt/tss-platform/model-cache
TSS_MODEL_CACHE_MOUNT_PATH=/var/cache/tss/models
TSS_MODEL_CACHE_MAX_BYTES=8589934592
TSS_MODEL_CACHE_MIN_FREE_BYTES=5368709120
TSS_MODEL_CACHE_RUNTIME_RESERVE_BYTES=13958643712

# Main currently uses locally built runtime images. Change this to registry and
# use one immutable Git SHA only after the runtime image promotion is verified.
TSS_RUNTIME_IMAGE_SOURCE=build
TSS_RUNTIME_IMAGE_TAG=local
TSS_IMAGE_REGISTRY=ghcr.io/tssai-lab
TSS_MLFLOW_IMAGE=tss-platform-mlflow:local
TSS_TRAINING_WORKER_IMAGE=tss-training-worker:local
TSS_INFERENCE_WORKER_IMAGE=tss-inference-worker-main-cpu:local

TSS_BACKEND_IMAGE_REPOSITORY=ghcr.io/tssai-lab/tssai-backend
TSS_BACKEND_HEALTH_URL=http://127.0.0.1:8080/health/ready
TSS_PLATFORM_URL=http://127.0.0.1:8080
TSS_MLFLOW_HEALTH_URL=http://127.0.0.1:5000/

TSS_MIN_CPU_CORES=2
TSS_MIN_MEMORY_MB=4096
TSS_MIN_FREE_DISK_MB=20480
TSS_ALLOW_OCCUPIED_PORTS=true
TSS_REMOVE_LEGACY_HELPERS=false
