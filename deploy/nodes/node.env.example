# Copy this file outside the repository, set non-secret node-specific values,
# protect it with mode 600, and pass its path through TSS_NODE_CONFIG.

TSS_NODE_ID=node-01
TSS_NODE_ROLES=app,worker
TSS_ENVIRONMENT=production
TSS_PLATFORM_DIR=/opt/tss-platform
TSS_DEPLOY_USER=tss-deployer

TSS_CLUSTER_NAME=tss-training-node-01
# Set this to the exact Kubernetes node that holds the reviewed worker images.
# A default kind cluster created from TSS_CLUSTER_NAME uses this name.
TSS_DEPLOYMENT_SMOKE_NODE=tss-training-node-01-control-plane
TSS_BACKEND_HOST_PORT=18080
TSS_MINIO_HOST_PORT=9010
TSS_MLFLOW_HOST_PORT=15000
TSS_BACKEND_LISTEN_PORT=8080
TSS_MLFLOW_LISTEN_PORT=5000
TSS_REDIS_LISTEN_PORT=6379

# Application dependency addresses. Keep loopback defaults only when the
# dependency is intentionally hosted on the same node.
TSS_SERVER_ADDRESS=127.0.0.1
TSS_SPRING_PROFILES_ACTIVE=default
TSS_POSTGRES_CONTAINER=tss-postgres
TSS_MINIO_CONTAINER=tss-minio
TSS_DATASOURCE_HOST=127.0.0.1
TSS_DATASOURCE_PORT=5432
TSS_MINIO_ENDPOINT=http://127.0.0.1:9010
TSS_MINIO_BUCKET=models
TSS_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
TSS_REDIS_HOST=127.0.0.1
TSS_REDIS_PORT=6379
TSS_TRAINING_EXPERIMENT_NAME=training
TSS_K8S_BACKEND_SERVICE_URL=http://backend:8080
TSS_K8S_MINIO_SERVICE_URL=http://minio:9000
TSS_K8S_MLFLOW_SERVICE_URL=http://mlflow:5000

# Per-node content-addressed model cache. Keep disabled until the kind
# extraMount has been verified on this node.
TSS_MODEL_CACHE_ENABLED=false
TSS_MODEL_CACHE_HOST_PATH=/opt/tss-platform/model-cache
TSS_MODEL_CACHE_NODE_PATH=/var/lib/tss-platform/model-cache
TSS_MODEL_CACHE_MOUNT_PATH=/var/cache/tss/models
TSS_MODEL_CACHE_MAX_BYTES=1073741824
TSS_MODEL_CACHE_MIN_FREE_BYTES=3221225472
TSS_MODEL_CACHE_RUNTIME_RESERVE_BYTES=10737418240

# Use build for an isolated POC. Use registry with an immutable 40-character
# Git SHA after the runtime-images workflow is available.
TSS_RUNTIME_IMAGE_SOURCE=build
TSS_RUNTIME_IMAGE_TAG=local
TSS_IMAGE_REGISTRY=ghcr.io/example
TSS_MLFLOW_IMAGE=tss-platform-mlflow:local
TSS_REDIS_IMAGE=tss-platform-redis:7.4.11-alpine-amd64-5509c0097c60
TSS_REDIS_IMAGE_ID=sha256:5509c0097c6064aa8a3b1df58f1d950e67090fffa6678ae8f3f1dc2385f12deb
TSS_TRAINING_WORKER_IMAGE=tss-training-worker:local
TSS_INFERENCE_WORKER_IMAGE=tss-inference-worker-cpu:local

TSS_BACKEND_IMAGE_REPOSITORY=ghcr.io/example/backend
TSS_BACKEND_HEALTH_URL=http://127.0.0.1:8080/health/ready
TSS_PLATFORM_URL=http://127.0.0.1:8080
TSS_MLFLOW_HEALTH_URL=http://127.0.0.1:5000/

TSS_MIN_CPU_CORES=2
TSS_MIN_MEMORY_MB=4096
TSS_MIN_FREE_DISK_MB=20480
TSS_ALLOW_OCCUPIED_PORTS=false
TSS_REMOVE_LEGACY_HELPERS=true
